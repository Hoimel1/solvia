FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive

# System-Pakete installieren
RUN apt-get update && apt-get install -y \
    python3 python3-pip git wget curl build-essential kalign \
    && rm -rf /var/lib/apt/lists/*

# Pip auf den neuesten Stand bringen
RUN python3 -m pip install --upgrade pip

# JAX mit GPU-Unterstützung installieren (cuda11-kompatibel)
RUN pip install --no-cache-dir \
    "jax[cuda11_pip]" \
    -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html

# ColabFold und wesentliche Dependencies installieren
RUN pip install --no-cache-dir \
    "colabfold[alphafold]==1.5.5" \
    biopython==1.81 \
    PyYAML==6.0.1 \
    chex>=0.1.86

# Haiku aktualisieren, um den linear_util-Fehler zu umgehen
RUN pip install --no-cache-dir --upgrade dm-haiku

# **NumPy explizit installieren**, da es für Skripte benötigt wird
RUN pip install --no-cache-dir numpy

WORKDIR /work
ENTRYPOINT ["colabfold_batch"]